def _atr_scale_threshold(base: float, atr_scale: float) -> float:
    """Dynamically scale a fixed threshold by current ATR ratio.

    Symmetric +/-15% at extremes (clamped):
      atr_scale=0.70 -> base * 0.85  (tighten 15%)
      atr_scale=1.00 -> base unchanged
      atr_scale=2.00 -> base * 1.15  (loosen 15%)
    """
    bias = 1.0 + 0.50 * (atr_scale - 1.0)
    bias = max(0.85, min(1.15, bias))
    return base * bias


def _regime_pass(chop, cvdb, cvdu, cvd_absorb=None):
    """Vectorized chop + CVD-divergence filter. True = regime OK to trade.

    Blocks: chop_idx==1 (choppy), cvd_div_bear==1 (distribution),
            cvd_div_bull==1 (accumulation), cvd_absorb & cvdb.
    """
    mask = (chop == 0) & (cvdb == 0) & (cvdu == 0)
    if cvd_absorb is not None:
        mask = mask & ~(cvd_absorb & cvdb)
    return mask


def _oi_cvd_confluence(oi_rising, cvd_d):
    """True when OI and CVD momentum agree.
    Blocks: OI rising + CVD falling = passive positioning, not real demand.
    """
    if cvd_d is None:
        return np.ones(len(oi_rising), dtype=bool)
    return ~((oi_rising > 0) & (np.sign(cvd_d) < 0))