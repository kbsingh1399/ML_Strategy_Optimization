Python# TARGET: ensemble_strategy_predictor.py
# REPLACE all six signal_s1..signal_s6 functions with:

def signal_s1(df):  # S1: Liquidation — dynamic thresholds + chop + CVD
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values
    p8 = df.get("p8", 0).values
    lrl = df.get("liq_ratio_l", 1).values
    lrs = df.get("liq_ratio_s", 1).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    th_l = _atr_scale_threshold(0.15, atr_s)
    mask_l = (mc > 0) & (p8 < -th_l) & (lrl > 0.8) & (chop == 0) & (cvdb == 0)
    mask_s = (mc < 0) & (p8 > th_l) & (lrs > 0.8) & (chop == 0) & (cvdu == 0)
    out[mask_l] = 1; out[mask_s] = -1
    return out

def signal_s2(df):  # S2: CVD Momentum — dynamic thresholds + chop + CVD
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values; p8 = df.get("p8", 0).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    th = _atr_scale_threshold(0.18, atr_s)
    mask_l = (mc > 0) & (p8 < -th) & (chop == 0) & (cvdb == 0)
    mask_s = (mc < 0) & (p8 > th) & (chop == 0) & (cvdu == 0)
    out[mask_l] = 1; out[mask_s] = -1
    return out

def signal_s3(df):  # S3: Trend Follow — dynamic thresholds + chop + CVD
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values; p8 = df.get("p8", 0).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    th = _atr_scale_threshold(0.20, atr_s)
    mask_l = (mc > 0) & (p8 < -th) & (chop == 0) & (cvdb == 0)
    mask_s = (mc < 0) & (p8 > th) & (chop == 0) & (cvdu == 0)
    out[mask_l] = 1; out[mask_s] = -1
    return out

def signal_s4(df):  # S4: Mean Reversion — dynamic thresholds + chop + CVD
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values; p8 = df.get("p8", 0).values
    r = df.get("rsi", 50).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    th = _atr_scale_threshold(0.15, atr_s)
    mask_l = (mc > 0) & (p8 < -th) & (r < 40) & (chop == 0) & (cvdb == 0)
    mask_s = (mc < 0) & (p8 > th) & (r > 60) & (chop == 0) & (cvdu == 0)
    out[mask_l] = 1; out[mask_s] = -1
    return out

def signal_s5(df):  # S5: Vol Expansion — dynamic thresholds + chop + CVD
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values; p8 = df.get("p8", 0).values
    vr5 = df.get("vr5", 1).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    th = _atr_scale_threshold(0.15, atr_s)
    mask_l = (mc > 0) & (p8 < -th) & (vr5 > 0.9) & (chop == 0) & (cvdb == 0)
    mask_s = (mc < 0) & (p8 > th) & (vr5 > 0.9) & (chop == 0) & (cvdu == 0)
    out[mask_l] = 1; out[mask_s] = -1
    return out

def signal_s6(df):  # S6: OI Momentum — ATR + chop + CVD + OI-CVD confluence
    out = np.zeros(len(df), dtype=np.int32)
    mc = df.get("mc", 0).values; p8 = df.get("p8", 0).values
    oi_rising = df.get("oi_rising", 0).values
    cvd_d = df.get("cvd_d", 0).values
    atr_s = df.get("atr_scale", 1.0).values
    chop = df.get("chop_idx", 0).values
    cvdb = df.get("cvd_div_bear", 0).values
    cvdu = df.get("cvd_div_bull", 0).values
    regime_ok = _regime_pass(chop, cvdb, cvdu)
    oi_cvd_ok = _oi_cvd_confluence(oi_rising, cvd_d)
    th_trend = _atr_scale_threshold(0.18, atr_s)
    th_oi    = _atr_scale_threshold(0.12, atr_s)
    trend_l = (mc > 0) & (p8 < -th_trend)
    trend_s = (mc < 0) & (p8 >  th_trend)
    oi_l = (mc > 0) & (p8 < -th_oi) & (oi_rising > 0) & oi_cvd_ok
    oi_s = (mc < 0) & (p8 >  th_oi) & (oi_rising > 0) & oi_cvd_ok
    mask_l = (trend_l | oi_l) & regime_ok
    mask_s = (trend_s | oi_s) & regime_ok
    out[mask_l] = 1; out[mask_s] = -1
    return out


def signal_s7(df):  # S7: CVD-Price Divergence — directional alpha
    out = np.zeros(len(df), dtype=np.int32)
    mc     = df.get("mc", 0).values
    cvdb   = df.get("cvd_div_bear", 0).values
    cvdu   = df.get("cvd_div_bull", 0).values
    cv_acc = df.get("cvd_accel", 0).values
    chop   = df.get("chop_idx", 0).values
    regime_ok = _regime_pass(chop, cvdb, cvdu)
    mask_l = (mc > 0) & (cvdu > 0) & (cv_acc > 0) & regime_ok
    mask_s = (mc < 0) & (cvdb > 0) & (cv_acc < 0) & regime_ok
    out[mask_l] = 1; out[mask_s] = -1
    return out